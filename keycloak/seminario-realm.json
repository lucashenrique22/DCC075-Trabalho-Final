      "email": "bob@seminario.local",
      "firstName": "Bob",
      "lastName": "Souza",
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    },
    {
      "username": "mallory",
      "enabled": true,
      "emailVerified": true,
      "email": "mallory@seminario.local",
      "firstName": "Mallory",
      "lastName": "Atacante",
      "credentials": [
        {
          "type": "password",
          "value": "mallory123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "webapp-vulnerable",
      "roles": [
        "user",
        "admin"
      ]
    },
    {
      "client": "webapp-secure",
      "roles": [
        "user",
        "admin"
      ]
    },
    {
      "client": "cli-test",
      "roles": [
        "user",
        "admin"
      ]
    }
  ]
}